# Base URL of the local Ollama server
OLLAMA_HOST=http://localhost:11434

# SQLite database file (relative to backend/ or absolute path)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Comma-separated list of origins allowed to call this API (your Vite dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max number of prior messages (user+assistant) sent to Ollama as context per request
MAX_CONTEXT_MESSAGES=20

# Seconds to wait for Ollama before giving up on a request
OLLAMA_TIMEOUT_SECONDS=120
